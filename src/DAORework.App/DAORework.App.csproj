<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <!-- Cinzel (SIL OFL 1.1, ADR-0016) for headings. Its license ships beside it and in the release zip. -->
    <AvaloniaResource Include="Assets\Fonts\*.ttf" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\DAORework.Core\DAORework.Core.csproj" />
    <ProjectReference Include="..\DAORework.Application\DAORework.Application.csproj" />
    <ProjectReference Include="..\DAORework.Infrastructure\DAORework.Infrastructure.csproj" />
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>
</Project>
