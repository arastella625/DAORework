<!-- Korcari (ADR-0016): Witch of the Wilds without the glow, with a plain gold rule for emphasis.
     Colors only: ThemeResources adds the brushes, the glow and Fluent's colors from them. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <Color x:Key="BackgroundColor">#120D18</Color>
  <Color x:Key="SurfaceColor">#1E1528</Color>
  <Color x:Key="SurfaceRaisedColor">#2A1E38</Color>
  <Color x:Key="BorderColor">#6B5A3A</Color>
  <Color x:Key="BorderStrongColor">#8C7650</Color>
  <Color x:Key="TextPrimaryColor">#E8DFCF</Color>
  <Color x:Key="TextSecondaryColor">#A99BB8</Color>
  <Color x:Key="HeadingColor">#C9A96E</Color>
  <Color x:Key="AccentColor">#6D45C4</Color>
  <Color x:Key="OnAccentColor">#E8DFCF</Color>
  <Color x:Key="AccentTextColor">#A98BFA</Color>
  <Color x:Key="AccentSecondaryColor">#4F8A6E</Color>
  <Color x:Key="AccentSecondaryTextColor">#6FB394</Color>
  <Color x:Key="SuccessColor">#86BC72</Color>
  <Color x:Key="WarningColor">#C9A227</Color>
  <Color x:Key="DangerColor">#9E2B2B</Color>
  <Color x:Key="DangerTextColor">#E57373</Color>
  <Color x:Key="FocusGlowColor">#B9A3FF</Color>
  <Color x:Key="EmphasisStartColor">#6B5A3A</Color>
  <Color x:Key="EmphasisEndColor">#6B5A3A</Color>
  <sys:Double x:Key="GlowRadius">0</sys:Double>
</ResourceDictionary>
