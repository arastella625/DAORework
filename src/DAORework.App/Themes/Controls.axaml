<!-- The look of DAORework's own controls (ADR-0016). Every color is a theme token. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:DAORework.App.Controls">
  <!-- The gilded tome (ADR-0026 §4): light falling from the top, a gold frame with a fainter rule inside it, and filigree in
       each corner. A card marked framed takes Kenney's border instead of the filigree; a plain theme draws no ornaments. -->
  <ControlTheme x:Key="{x:Type controls:Card}" TargetType="controls:Card">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Padding" Value="18,16" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}" />
          </Border>
          <Border Name="InnerRule" Margin="5" BorderBrush="{DynamicResource InnerRuleBrush}" BorderThickness="1" CornerRadius="2"
                  IsHitTestVisible="False" Opacity="{DynamicResource OrnamentOpacity}" />
          <Panel Name="Filigree" IsHitTestVisible="False">
            <Path Data="{StaticResource FiligreeCorner}" Stroke="{DynamicResource BorderBrush}" StrokeThickness="1.2"
                  Width="26" Height="26" Margin="3" HorizontalAlignment="Left" VerticalAlignment="Top" />
            <Path Data="{StaticResource FiligreeCorner}" Stroke="{DynamicResource BorderBrush}" StrokeThickness="1.2"
                  Width="26" Height="26" Margin="3" HorizontalAlignment="Right" VerticalAlignment="Top" RenderTransform="scaleX(-1)" />
            <Path Data="{StaticResource FiligreeCorner}" Stroke="{DynamicResource BorderBrush}" StrokeThickness="1.2"
                  Width="26" Height="26" Margin="3" HorizontalAlignment="Left" VerticalAlignment="Bottom" RenderTransform="scaleY(-1)" />
            <Path Data="{StaticResource FiligreeCorner}" Stroke="{DynamicResource BorderBrush}" StrokeThickness="1.2"
                  Width="26" Height="26" Margin="3" HorizontalAlignment="Right" VerticalAlignment="Bottom" RenderTransform="rotate(180deg)" />
          </Panel>
          <controls:NineSliceFrame Name="Frame" IsVisible="False" Opacity="{DynamicResource OrnamentOpacity}"
                                   Source="avares://DAORework.App/Assets/Kenney/panel-border-001.png" Brush="{DynamicResource HeadingBrush}" />
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^.framed /template/ controls|NineSliceFrame#Frame">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^.framed /template/ Panel#Filigree">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^.framed /template/ Border#InnerRule">
      <Setter Property="IsVisible" Value="False" />
    </Style>
  </ControlTheme>

  <!-- A seal: a scalloped ring and a fine inner ring in the status color, the icon in the middle (ADR-0026 §4). -->
  <ControlTheme x:Key="{x:Type controls:Seal}" TargetType="controls:Seal">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Ellipse Stroke="{TemplateBinding Foreground}" StrokeThickness="3" StrokeDashArray="1.1,0.8" />
          <Ellipse Margin="5" Stroke="{TemplateBinding Foreground}" StrokeThickness="1" />
          <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^.warning">
      <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type controls:RuneDivider}" TargetType="controls:RuneDivider">
    <Setter Property="Width" Value="360" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid ColumnDefinitions="*,Auto,*" Height="10">
          <Rectangle Height="1" Fill="{DynamicResource BorderFadeInBrush}" />
          <Path Grid.Column="1" Margin="8,0" Width="56" Height="10" Data="{StaticResource RuneGlyph}"
                Stroke="{DynamicResource BorderBrush}" StrokeThickness="1" />
          <Rectangle Grid.Column="2" Height="1" Fill="{DynamicResource BorderFadeOutBrush}" />
        </Grid>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type controls:Backdrop}" TargetType="controls:Backdrop">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border Background="{DynamicResource BackgroundBrush}" />
          <!-- A custom look's picture (ADR-0017), tinted already, under a veil of the background at no less than its floor. -->
          <Image Source="{DynamicResource LookPicture}" Stretch="{DynamicResource LookPictureStretch}"
                 Effect="{DynamicResource LookPictureBlur}" IsHitTestVisible="False" />
          <Border Background="{DynamicResource BackgroundBrush}" Opacity="{DynamicResource LookVeilOpacity}" IsHitTestVisible="False" />
          <Border Background="{DynamicResource SmokeBrush}" />
          <Border Background="{DynamicResource GrainBrush}" Opacity="0.04" IsHitTestVisible="False" />
          <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" Padding="{TemplateBinding Padding}" />
        </Panel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
