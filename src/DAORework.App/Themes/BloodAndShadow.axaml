<!-- Blood and Shadow (ADR-0016): iron, leather and a bronze accent; crimson only for emphasis and danger.
     Colors only: ThemeResources adds the brushes, the glow and Fluent's colors from them. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <Color x:Key="BackgroundColor">#100B0D</Color>
  <Color x:Key="SurfaceColor">#1A1214</Color>
  <Color x:Key="SurfaceRaisedColor">#251A1D</Color>
  <Color x:Key="BorderColor">#5A4A44</Color>
  <Color x:Key="BorderStrongColor">#8A7A6E</Color>
  <Color x:Key="TextPrimaryColor">#EADFD2</Color>
  <Color x:Key="TextSecondaryColor">#AE9C98</Color>
  <Color x:Key="HeadingColor">#C9A96E</Color>
  <Color x:Key="AccentColor">#6E5130</Color>
  <Color x:Key="OnAccentColor">#EADFD2</Color>
  <Color x:Key="AccentTextColor">#C79A5B</Color>
  <Color x:Key="AccentSecondaryColor">#5E534D</Color>
  <Color x:Key="AccentSecondaryTextColor">#A99A90</Color>
  <Color x:Key="SuccessColor">#86BC72</Color>
  <Color x:Key="WarningColor">#C9A227</Color>
  <Color x:Key="DangerColor">#9E2B2B</Color>
  <Color x:Key="DangerTextColor">#E07A7F</Color>
  <Color x:Key="FocusGlowColor">#D4A86A</Color>
  <Color x:Key="EmphasisStartColor">#9E2B2B</Color>
  <Color x:Key="EmphasisEndColor">#C79A5B</Color>
  <sys:Double x:Key="GlowRadius">8</sys:Double>
</ResourceDictionary>
