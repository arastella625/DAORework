<!-- Resources every theme shares (ADR-0016): the fonts, and the icons and motifs, all drawn for DAORework as vectors.
     Nothing here is copied or traced from the game. Colors come from the theme, where the controls use these. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Cinzel for titles only; body text stays in Inter (rule 6). -->
  <FontFamily x:Key="HeadingFontFamily">avares://DAORework.App/Assets/Fonts#Cinzel</FontFamily>
  <FontFamily x:Key="MonoFontFamily">Consolas, Menlo, DejaVu Sans Mono, monospace</FontFamily>

  <!-- 16 by 16 icons, filled, for PathIcon. Severity is never shown by color alone (rule 4). -->
  <StreamGeometry x:Key="IconInfo">F0 M8,1 A7,7 0 1 1 7.99,1 Z M8,2.5 A5.5,5.5 0 1 0 8.01,2.5 Z M7.25,7 H8.75 V11.75 H7.25 Z M7.25,4.25 H8.75 V5.75 H7.25 Z</StreamGeometry>
  <StreamGeometry x:Key="IconWarning">F0 M8,1 L15.5,14.5 H0.5 Z M8,4 L2.9,13 H13.1 Z M7.25,6.25 H8.75 V10 H7.25 Z M7.25,11 H8.75 V12.5 H7.25 Z</StreamGeometry>
  <StreamGeometry x:Key="IconError">F0 M5,1 H11 L15,5 V11 L11,15 H5 L1,11 V5 Z M5.6,2.5 H10.4 L13.5,5.6 V10.4 L10.4,13.5 H5.6 L2.5,10.4 V5.6 Z M5.2,6.3 L6.3,5.2 L8,6.9 L9.7,5.2 L10.8,6.3 L9.1,8 L10.8,9.7 L9.7,10.8 L8,9.1 L6.3,10.8 L5.2,9.7 L6.9,8 Z</StreamGeometry>
  <StreamGeometry x:Key="IconOk">M2.5,8.4 L3.6,7.3 L6.3,10 L12.4,3.9 L13.5,5 L6.3,12.2 Z</StreamGeometry>
  <StreamGeometry x:Key="IconLock">M3,7 H13 V15 H3 Z M5,7 V5 A3,3 0 0 1 11,5 V7 H9.5 V5 A1.5,1.5 0 0 0 6.5,5 V7 Z</StreamGeometry>
  <StreamGeometry x:Key="IconShield">M8,1 L14,3.2 V7.5 C14,11.2 11.5,13.9 8,15 C4.5,13.9 2,11.2 2,7.5 V3.2 Z</StreamGeometry>
  <StreamGeometry x:Key="IconMove">M1,7.25 H9 V4.5 L12.5,8 L9,11.5 V8.75 H1 Z M13.5,3 H15 V13 H13.5 Z</StreamGeometry>
  <StreamGeometry x:Key="IconMinus">F0 M8,1 A7,7 0 1 1 7.99,1 Z M8,2.5 A5.5,5.5 0 1 0 8.01,2.5 Z M4.75,7.25 H11.25 V8.75 H4.75 Z</StreamGeometry>

  <!-- The app's emblem, a raven feather (32 by 32), a nod to the Witch of the Wilds that copies nothing. -->
  <StreamGeometry x:Key="EmblemFeather">M28.5,2.5 C19.5,4.1 12.1,9.9 8.9,18.6 L7.3,23.2 L10,22.5 C10.6,20.6 11.6,18.8 12.8,17.1 L12.2,20.5 L14.6,19.2 L15,16 L16.4,18.3 L18.6,16.7 L18.2,13.7 L20.2,15.3 C24,11.7 26.6,7.2 28.5,2.5 Z M25,5.2 L25.9,6 L4.6,29.4 L3.7,28.6 Z</StreamGeometry>

  <!-- Stroked motifs: the rune under a page title (56 by 10) and a card's corner filigree (26 by 26). -->
  <StreamGeometry x:Key="RuneGlyph">M28,1 L32,5 L28,9 L24,5 Z M18,2 V8 M15,5 H21 M38,2 V8 M35,3 L41,7 M10,5 H13 M43,5 H46</StreamGeometry>
  <StreamGeometry x:Key="FiligreeCorner">M1,18 V6 A5,5 0 0 1 6,1 H18 M4,13 A9,9 0 0 1 13,4 M7,7 L9,9 M5.5,3.5 L6.5,4.5</StreamGeometry>
</ResourceDictionary>
