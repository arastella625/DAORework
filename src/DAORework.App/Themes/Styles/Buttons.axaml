<!-- Buttons over the theme tokens (ADR-0016). Fluent's accent button already takes the Accent brushes from the theme.
     These come after FluentTheme, so they win over its pointer-over and pressed states. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- The gilded tome (ADR-0026 §4): every button carries an inner dark rule and a faint gold one; the main button is
       edged in gold with a Cinzel label. -->
  <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BoxShadow" Value="{DynamicResource ButtonRuleShadow}" />
    <Setter Property="CornerRadius" Value="3" />
  </Style>
  <Style Selector="Button.accent">
    <Setter Property="FontFamily" Value="{StaticResource HeadingFontFamily}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.accent /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource HeadingBrush}" />
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BoxShadow" Value="{DynamicResource GlowShadow}" />
  </Style>
  <Style Selector="Button:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BoxShadow" Value="{DynamicResource GlowShadow}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FocusGlowBrush}" />
  </Style>

  <!-- An on/off switch: a dark groove and a gem knob that sits right and glows when on, pewter and left when off.
       The button's label (On or Off) stays beside it, so the state is never color alone. -->
  <!-- A mod's name on its one-line row (ADR-0038): reads as text, and shows it can be pressed only when pointed at. -->
  <Style Selector="ToggleButton.rowName">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="8,4" />
  </Style>
  <Style Selector="ToggleButton.rowName /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ToggleButton.rowName:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ToggleButton.rowName:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BorderSoftBrush}" />
  </Style>
  <Style Selector="Button.switch">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel Orientation="Horizontal" Spacing="8" Background="Transparent">
          <Panel Width="48" Height="26">
            <Border Name="Track" CornerRadius="13" Background="{DynamicResource BackgroundBrush}"
                    BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" />
            <Ellipse Name="Knob" Width="18" Height="18" Margin="4,0" HorizontalAlignment="Left" Fill="{DynamicResource GemOffBrush}" />
          </Panel>
          <ContentPresenter Name="Label" Content="{TemplateBinding Content}" VerticalAlignment="Center"
                            Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.switch.on /template/ Ellipse#Knob">
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="Fill" Value="{DynamicResource GemOnBrush}" />
  </Style>
  <Style Selector="Button.switch.on /template/ Border#Track">
    <Setter Property="BorderBrush" Value="{DynamicResource HeadingBrush}" />
  </Style>
  <Style Selector="Button.switch.on /template/ ContentPresenter#Label">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="Button.switch:pointerover /template/ Border#Track, Button.switch:focus-visible /template/ Border#Track">
    <Setter Property="BorderBrush" Value="{DynamicResource FocusGlowBrush}" />
    <Setter Property="BoxShadow" Value="{DynamicResource GlowShadow}" />
  </Style>

  <!-- A filled red button is only ever a destructive confirm, such as Roll back (ADR-0016 rule 3). -->
  <Style Selector="Button.danger /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource DangerTextBrush}" />
  </Style>
</Styles>
