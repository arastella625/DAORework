<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DAORework.App.ViewModels"
             xmlns:controls="using:DAORework.App.Controls"
             xmlns:mods="using:DAORework.Core.Mods"
             xmlns:views="using:DAORework.App.Views"
             x:Class="DAORework.App.Views.NextMovePanel"
             x:DataType="vm:NextMoveCard">
  <!-- The one next step (docs/WORKFLOWS.md). Not an accent button: each screen keeps its one main button (docs/VOICE.md rule 6). -->
  <controls:Card Name="NextMove" Margin="12,0">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <StackPanel Spacing="2">
        <TextBlock Name="NextMoveTitle" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Title}" />
        <TextBlock Classes="Secondary" TextWrapping="Wrap" Text="{Binding Body}" />
        <!-- Where a new player is (P2.6-36). It goes once a mod is on, so there is nothing to dismiss. -->
        <ItemsControl Name="FirstSteps" Margin="0,6,0,0" ItemsSource="{Binding FirstSteps}"
                      IsVisible="{Binding FirstSteps.Count, Converter={x:Static views:CountConverters.IsPositive}}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="16" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="mods:FirstStep">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <PathIcon Classes="Ok" Width="12" Height="12" Data="{StaticResource IconOk}" IsVisible="{Binding IsDone}" />
                <TextBlock Classes="Secondary" Text="{Binding Name}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
      <Button Name="NextMoveButton" Grid.Column="1" VerticalAlignment="Center" Content="{Binding Button}"
              Command="{Binding TakeCommand}" IsVisible="{Binding HasButton}" />
    </Grid>
  </controls:Card>
</UserControl>
