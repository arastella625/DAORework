<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DAORework.App.ViewModels"
             xmlns:views="using:DAORework.App.Views"
             x:Class="DAORework.App.Views.PreviewSheet"
             x:DataType="vm:ModsTabViewModel">
  <!-- Every preview on the Mods tab (ADR-0038): docked below the list, which shrinks to make room, so its buttons always
       show and the list stays reachable. Only the plan scrolls. -->
  <StackPanel>
    <!-- Asked before anything is added (ADR-0039), so taking over comes before a second copy. -->
    <Border Name="LookFirstSheet" Classes="sheet" IsVisible="{Binding LookFirst.IsShown}">
      <StackPanel Spacing="8">
        <TextBlock Classes="SectionTitle" Text="{Binding LookFirst.Title}" />
        <ScrollViewer MaxHeight="230">
          <ItemsControl Name="HeldDownloads" ItemsSource="{Binding LookFirst.Held}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:HeldDownloadRow">
                <TextBlock Margin="0,2" Text="{Binding Line}" TextWrapping="Wrap" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Button Name="ManageHeldButton" Classes="accent" Content="{Binding LookFirst.ManageLabel}" Command="{Binding LookFirst.ManageHeldCommand}"
                  IsVisible="{Binding LookFirst.CanManage}" />
          <Button Name="AddAnywayButton" Content="Add anyway" Command="{Binding LookFirst.AddAnywayCommand}" />
          <Button Name="CancelHeldButton" Content="Cancel" Command="{Binding LookFirst.CancelCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Name="KeepCopySheet" Classes="sheet"
            IsVisible="{Binding KeepCopy.Preview.Title, Converter={x:Static ObjectConverters.IsNotNull}}">
      <StackPanel Spacing="8">
        <ScrollViewer MaxHeight="230">
          <views:PlanPreviewView DataContext="{Binding KeepCopy.Preview}" />
        </ScrollViewer>
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Button Name="RemoveOthersButton" Classes="accent" Content="{Binding KeepCopy.RemoveLabel}" Command="{Binding KeepCopy.RemoveOthersCommand}" />
          <Button Name="CancelKeepButton" Content="Cancel" Command="{Binding KeepCopy.CancelCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Every set at once (ADR-0039). The plan and the list scroll apart, so what comes back and the first sets stay in view. -->
    <Border Name="KeepEachSheet" Classes="sheet"
            IsVisible="{Binding KeepEach.Preview.Title, Converter={x:Static ObjectConverters.IsNotNull}}">
      <StackPanel Spacing="8">
        <ScrollViewer MaxHeight="{Binding $parent[Window].Bounds.Height, Converter={x:Static views:SheetHeights.PlanFor}}">
          <views:PlanPreviewView DataContext="{Binding KeepEach.Preview}" />
        </ScrollViewer>
        <ScrollViewer Name="KeepEachScroller" MaxHeight="{Binding $parent[Window].Bounds.Height, Converter={x:Static views:SheetHeights.ListFor}}">
          <ItemsControl Name="KeepEachSets" ItemsSource="{Binding KeepEach.Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:KeepEachRow">
                <Grid Margin="0,1,12,1" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8">
                  <TextBlock VerticalAlignment="Center" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                  <ComboBox Grid.Column="1" Name="KeepPick" Width="300" MinHeight="26" Padding="8,2" ItemsSource="{Binding Choices}" SelectedItem="{Binding Pick}"
                            ToolTip.Tip="Which copy to keep">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:KeepChoice">
                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Classes="Secondary" Text="{Binding Note}" TextWrapping="Wrap"
                             IsVisible="{Binding Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Classes="Warning" Text="{Binding Stopped}" TextWrapping="Wrap"
                             IsVisible="{Binding Stopped, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Button Name="RemoveCopiesButton" Classes="accent" Content="{Binding KeepEach.RemoveLabel}" Command="{Binding KeepEach.RemoveCopiesCommand}" />
          <Button Name="CancelKeepEachButton" Content="Cancel" Command="{Binding KeepEach.CancelCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Name="PlanPreview" Classes="sheet"
            IsVisible="{Binding Activation.Preview.Title, Converter={x:Static ObjectConverters.IsNotNull}}">
      <StackPanel Spacing="8">
        <ScrollViewer MaxHeight="230">
          <StackPanel Spacing="8">
            <views:PlanPreviewView DataContext="{Binding Activation.Preview}" />
            <TextBlock Classes="Secondary" TextWrapping="Wrap" IsVisible="{Binding Activation.CanApply}"
                       Text="Nothing changes in your game until you apply it." />
          </StackPanel>
        </ScrollViewer>
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Button Name="ApplyPlanButton" Classes="accent" Content="Apply" Command="{Binding Activation.ApplyCommand}"
                  IsVisible="{Binding !Activation.CanLeaveOut}" />
          <Button Name="LeaveOutButton" Classes="accent" Content="{Binding Activation.LeaveOutLabel}" Command="{Binding Activation.LeaveOutCommand}"
                  IsVisible="{Binding Activation.CanLeaveOut}" />
          <Button Name="CancelPlanButton" Content="Cancel" Command="{Binding Activation.CancelPlanCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Name="AdoptionPlan" Classes="sheet"
            IsVisible="{Binding HandInstalled.Adoption.Preview.Title, Converter={x:Static ObjectConverters.IsNotNull}}">
      <StackPanel Spacing="8">
        <ScrollViewer MaxHeight="230">
          <StackPanel Spacing="8">
            <views:PlanPreviewView DataContext="{Binding HandInstalled.Adoption.Preview}" />
            <StackPanel Name="WhoWinsSection" Spacing="4"
                        IsVisible="{Binding HandInstalled.Adoption.WhoWins.Count, Converter={x:Static views:CountConverters.IsPositive}}">
              <TextBlock Classes="Label" Text="Who wins" />
              <TextBlock Classes="Secondary" TextWrapping="Wrap"
                         Text="These mods have different files with the same name, and your game can only use one. The other stays in your Library. Swap to change who wins." />
              <ItemsControl Name="WhoWinsList" ItemsSource="{Binding HandInstalled.Adoption.WhoWins}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:WhoWinsRow">
                    <Border Padding="0,6" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,1,0,0">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <StackPanel Spacing="2">
                          <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                          <TextBlock Classes="Secondary" Text="{Binding Kinds}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Swap" VerticalAlignment="Center" IsVisible="{Binding CanSwap}" CommandParameter="{Binding}"
                                Command="{Binding $parent[views:PreviewSheet].((vm:ModsTabViewModel)DataContext).HandInstalled.Adoption.SwapCommand}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <TextBlock Classes="Secondary" TextWrapping="Wrap"
                       Text="Planning copied what is adopted into the Library, which writes only DAORework's own folder. Nothing in the documents folder moves until you apply it; a backup is taken first." />
          </StackPanel>
        </ScrollViewer>
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Button Name="ApplyAdoptionButton" Classes="accent" Content="Apply" Command="{Binding HandInstalled.Adoption.ApplyCommand}"
                  IsVisible="{Binding !HandInstalled.Adoption.CanLeaveOut}" />
          <Button Name="LeaveOutAdoptionButton" Classes="accent" Content="{Binding HandInstalled.Adoption.LeaveOutLabel}" Command="{Binding HandInstalled.Adoption.LeaveOutCommand}"
                  IsVisible="{Binding HandInstalled.Adoption.CanLeaveOut}" />
          <Button Name="CancelAdoptionButton" Content="Cancel" Command="{Binding HandInstalled.Adoption.CancelPlanCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Name="OrderPlan" Classes="sheet" IsVisible="{Binding LoadOrder.IsReordered}">
      <StackPanel Spacing="8">
        <ScrollViewer MaxHeight="230">
          <views:PlanPreviewView DataContext="{Binding LoadOrder.Preview}" />
        </ScrollViewer>
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Button Name="ApplyOrderButton" Classes="accent" Content="Apply" Command="{Binding LoadOrder.ApplyCommand}" />
          <Button Name="ResetOrderButton" Content="Back to the saved order" Command="{Binding LoadOrder.ResetCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
