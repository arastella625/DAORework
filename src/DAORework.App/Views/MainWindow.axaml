<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DAORework.App.ViewModels"
        xmlns:views="using:DAORework.App.Views"
        xmlns:controls="using:DAORework.App.Controls"
        x:Class="DAORework.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="DAORework"
        Width="960" Height="640"
        MinWidth="720" MinHeight="480"
        Background="{DynamicResource BackgroundBrush}">
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="16,12" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,0,0,1">
      <!-- The status lines live outside the grid: inside it, a long message widens the auto columns and pushes the buttons off-screen. -->
      <StackPanel Spacing="6">
        <Grid ColumnDefinitions="Auto,14,Auto,220,16,Auto,200,8,Auto,*,Auto" IsEnabled="{Binding !Change.IsRunning}">
          <PathIcon Grid.Column="0" Data="{StaticResource EmblemFeather}" Width="22" Height="22"
                    Foreground="{DynamicResource HeadingBrush}" ToolTip.Tip="DAORework" />
          <TextBlock Grid.Column="2" Text="Profile" VerticalAlignment="Center" Margin="0,0,8,0" />
          <ComboBox Grid.Column="3" Name="ProfileSelector" HorizontalAlignment="Stretch"
                    ItemsSource="{Binding Profiles.Profiles}" SelectedItem="{Binding Profiles.SelectedProfile}" PlaceholderText="No profiles yet" />
          <TextBlock Grid.Column="5" Text="New" VerticalAlignment="Center" Margin="0,0,8,0" />
          <TextBox Grid.Column="6" Name="NewProfileName" Text="{Binding Profiles.NewProfileName}" PlaceholderText="Profile name" />
          <Button Grid.Column="8" Name="CreateProfileButton" Content="Create" Command="{Binding Profiles.CreateProfileCommand}" />
          <Button Grid.Column="10" Name="LaunchButton" Content="Play" Classes="accent" Command="{Binding Launch.LaunchCommand}" />
        </Grid>
        <TextBlock Name="ProfilesStatus" Classes="Status" Classes.Error="{Binding Profiles.IsError}" Text="{Binding Profiles.StatusMessage}"
                   IsVisible="{Binding Profiles.StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <TextBlock Name="LaunchStatus" Classes="Status" Classes.Error="{Binding Launch.IsError}" Text="{Binding Launch.StatusMessage}"
                   IsVisible="{Binding Launch.StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
    </Border>
    <!-- A big change takes minutes: without this the window looks idle, and a second change only finds the first one's journal. -->
    <Border DockPanel.Dock="Top" Name="ChangeBanner" Padding="16,10" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,0,0,1" IsVisible="{Binding Change.IsRunning}">
      <StackPanel Spacing="6">
        <TextBlock FontWeight="SemiBold" Text="{Binding Change.Title}" />
        <ProgressBar Name="ChangeProgress" Minimum="0" Maximum="100" Value="{Binding Change.Percent}" IsIndeterminate="{Binding !Change.HasSteps}" />
        <TextBlock Classes="Secondary" Text="{Binding Change.Detail}" />
      </StackPanel>
    </Border>
    <!-- Said once here instead of on every panel (docs/VOICE.md rule 3). -->
    <Border DockPanel.Dock="Bottom" Padding="16,8" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,1,0,0">
      <TextBlock Name="UndoPromise" Classes="Secondary" Text="Every change to your game can be undone in History." />
    </Border>
    <controls:Backdrop>
      <TabControl Name="Pages" Margin="8" SelectedIndex="{Binding SelectedPage}" IsEnabled="{Binding !Change.IsRunning}">
        <TabItem Header="Home">
          <views:HomePage DataContext="{Binding Home}" />
        </TabItem>
        <TabItem Header="Mods">
          <DockPanel>
            <views:PreviewSheet DockPanel.Dock="Bottom" DataContext="{Binding ModsTab}" />
            <ScrollViewer>
              <views:ModsListPanel Margin="0,12,0,0" DataContext="{Binding ModsTab}" />
            </ScrollViewer>
          </DockPanel>
        </TabItem>
        <TabItem Header="Fixes">
          <ScrollViewer>
            <views:FixesPage DataContext="{Binding Fixes}" />
          </ScrollViewer>
        </TabItem>
        <TabItem Header="Saves">
          <views:SavesPage DataContext="{Binding Saves}" />
        </TabItem>
        <TabItem Header="History">
          <!-- Every change DAORework made, from Mods and Fixes, each undoable (ADR-0026, P2.5-27). -->
          <ScrollViewer>
            <StackPanel Spacing="12">
              <StackPanel Margin="12,12,12,0" Spacing="6">
                <TextBlock Classes="PageTitle" Text="History" />
                <controls:RuneDivider />
                <TextBlock Classes="Secondary" TextWrapping="Wrap"
                           Text="Every change DAORework made to your game, newest first. Undo goes back to just before it, and asks first." />
              </StackPanel>
              <views:ChangesPanel DataContext="{Binding ModsTab.Changes}" />
              <views:FixHistoryPanel DataContext="{Binding Fixes.Status}" />
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="Settings">
          <!-- The look first; the profile's folders and Troubleshooting stay closed until wanted (ADR-0026 §1). -->
          <ScrollViewer>
            <StackPanel Spacing="12">
              <views:SettingsPage DataContext="{Binding Settings}" />
              <views:NewDownloadsSettingsPanel DataContext="{Binding ModsTab.NewDownloads.Settings}" />
              <Expander Name="GameFolders" Margin="12,0" Header="Game folders" IsExpanded="{Binding GameFoldersOpen}" HorizontalAlignment="Stretch">
                <views:ProfilePage DataContext="{Binding Profile}" />
              </Expander>
              <Expander Name="Troubleshooting" Margin="12,0,12,12" Header="Troubleshooting" IsExpanded="{Binding TroubleshootingOpen}" HorizontalAlignment="Stretch">
                <StackPanel Spacing="12">
                  <views:DiagnosticsPage DataContext="{Binding Diagnostics}" />
                  <views:ModsPage DataContext="{Binding Mods}" />
                </StackPanel>
              </Expander>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
      </TabControl>
    </controls:Backdrop>
  </DockPanel>
</Window>
