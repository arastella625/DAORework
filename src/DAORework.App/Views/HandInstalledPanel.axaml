<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DAORework.App.ViewModels"
             xmlns:views="using:DAORework.App.Views"
             xmlns:controls="using:DAORework.App.Controls"
             x:Class="DAORework.App.Views.HandInstalledPanel"
             x:DataType="vm:HandInstalledViewModel">
  <UserControl.Resources>
    <DataTemplate x:Key="Candidate" x:DataType="vm:HandInstalledModRow">
      <Border Padding="0,10" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,1,0,0">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
          <CheckBox VerticalAlignment="Top" IsChecked="{Binding IsSelected}" IsVisible="{Binding CanManage}" ToolTip.Tip="Tick to adopt it with the others" />
          <StackPanel Grid.Column="1" Spacing="3">
            <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
            <TextBlock Classes="Mono Secondary" Text="{Binding Details}" TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding Notes}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="Open the mod's page" HorizontalAlignment="Left" CommandParameter="{Binding PageLink}"
                    IsVisible="{Binding PageLink, Converter={x:Static ObjectConverters.IsNotNull}}"
                    Command="{Binding $parent[views:ModsListPanel].((vm:ModsTabViewModel)DataContext).ModPage.OpenCommand}" />
            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding NeedsName}">
              <TextBlock VerticalAlignment="Center" Text="Name them" />
              <TextBox Name="LooseFilesName" Width="240" PlaceholderText="a name for these files"
                       Text="{Binding $parent[views:HandInstalledPanel].((vm:HandInstalledViewModel)DataContext).Adoption.LooseFilesName}" />
            </StackPanel>
          </StackPanel>
          <Button Grid.Column="2" VerticalAlignment="Top" Content="Manage" CommandParameter="{Binding}" IsVisible="{Binding CanManage}"
                  Command="{Binding $parent[views:HandInstalledPanel].((vm:HandInstalledViewModel)DataContext).Adoption.AdoptCommand}" />
        </Grid>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="Row" x:DataType="vm:HandInstalledModRow">
      <Border Padding="0,10" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,1,0,0">
        <StackPanel Spacing="3">
          <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
          <TextBlock Classes="Mono Secondary" Text="{Binding Details}" TextWrapping="Wrap" />
          <ItemsControl ItemsSource="{Binding Notes}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>
  <controls:Card Margin="12,0,12,12">
    <StackPanel Spacing="10">
      <TextBlock Classes="SectionTitle" Text="Found in your game" />
      <StackPanel Orientation="Horizontal" Spacing="12">
        <Button Name="ScanButton" Content="Look again" Command="{Binding ScanCommand}" />
        <TextBlock VerticalAlignment="Center" Classes="Secondary" TextWrapping="Wrap"
                   Text="Mods you put in your game yourself. Manage them to turn them off or undo them later, like any other mod." />
      </StackPanel>
      <TextBlock Name="HandInstalledStatus" Classes="Status" Classes.Error="{Binding IsError}" Text="{Binding StatusMessage}" />
      <Border Name="AdoptionPlan" Padding="12" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource BorderSoftBrush}"
              IsVisible="{Binding Adoption.Preview.Title, Converter={x:Static ObjectConverters.IsNotNull}}">
        <StackPanel Spacing="8">
          <views:PlanPreviewView DataContext="{Binding Adoption.Preview}" />
          <StackPanel Name="WhoWinsSection" Spacing="4"
                      IsVisible="{Binding Adoption.WhoWins.Count, Converter={x:Static views:CountConverters.IsPositive}}">
            <TextBlock Classes="Label" Text="Who wins" />
            <TextBlock Classes="Secondary" TextWrapping="Wrap"
                       Text="These mods have different files with the same name, and your game can only use one. The other stays in your Library. Swap to change who wins." />
            <ItemsControl Name="WhoWinsList" ItemsSource="{Binding Adoption.WhoWins}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:WhoWinsRow">
                  <Border Padding="0,6" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,1,0,0">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <StackPanel Spacing="2">
                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                        <TextBlock Classes="Secondary" Text="{Binding Kinds}" TextWrapping="Wrap" />
                      </StackPanel>
                      <Button Grid.Column="1" Content="Swap" VerticalAlignment="Center" IsVisible="{Binding CanSwap}" CommandParameter="{Binding}"
                              Command="{Binding $parent[views:HandInstalledPanel].((vm:HandInstalledViewModel)DataContext).Adoption.SwapCommand}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <TextBlock Classes="Secondary" TextWrapping="Wrap"
                     Text="Planning copied what is adopted into the Library, which writes only DAORework's own folder. Nothing in the documents folder moves until you apply it; a backup is taken first." />
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Button Name="ApplyAdoptionButton" Classes="accent" Content="Apply" Command="{Binding Adoption.ApplyCommand}" />
            <Button Name="CancelAdoptionButton" Content="Cancel" Command="{Binding Adoption.CancelPlanCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
      <TextBlock Name="AdoptionStatus" Classes="Status" Classes.Error="{Binding Adoption.IsError}" Text="{Binding Adoption.StatusMessage}" TextWrapping="Wrap"
                 IsVisible="{Binding Adoption.StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <StackPanel Name="SelectionBar" Orientation="Horizontal" Spacing="8">
        <StackPanel.IsVisible>
          <MultiBinding Converter="{x:Static BoolConverters.And}">
            <Binding Path="HasManageable" />
            <Binding Path="!$parent[views:ModsListPanel].((vm:ModsTabViewModel)DataContext).Filter.IsGameFolder" />
          </MultiBinding>
        </StackPanel.IsVisible>
        <Button Name="AdoptSelectedButton" Classes="accent" Content="Manage selected" Command="{Binding AdoptSelectedCommand}" />
        <Button Name="SelectAllButton" Content="Select all" Command="{Binding SelectAllCommand}" />
        <Button Name="ClearSelectionButton" Content="Clear" Command="{Binding ClearSelectionCommand}" />
        <TextBlock VerticalAlignment="Center" Classes="Secondary" TextWrapping="Wrap"
                   Text="Ticked mods are managed together, in one change you can undo." />
      </StackPanel>
      <ItemsControl Name="Candidates" ItemsSource="{Binding $parent[views:ModsListPanel].((vm:ModsTabViewModel)DataContext).Filter.VisibleFound}" ItemTemplate="{StaticResource Candidate}" />
      <TextBlock Classes="Label" Text="Cannot be adopted" Margin="0,6,0,0"
                 IsVisible="{Binding NotAdoptable.Count, Converter={x:Static views:CountConverters.IsPositive}}" />
      <ItemsControl Name="NotAdoptable" ItemsSource="{Binding NotAdoptable}" ItemTemplate="{StaticResource Row}" />
      <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding OfficialSummary, Converter={x:Static ObjectConverters.IsNotNull}}">
        <PathIcon Classes="Muted" Data="{StaticResource IconLock}" />
        <TextBlock Name="OfficialSummary" Classes="Secondary" Text="{Binding OfficialSummary}" TextWrapping="Wrap" />
      </StackPanel>
    </StackPanel>
  </controls:Card>
</UserControl>
