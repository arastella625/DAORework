<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DAORework.App.ViewModels"
             xmlns:views="using:DAORework.App.Views"
             xmlns:controls="using:DAORework.App.Controls"
             x:Class="DAORework.App.Views.CombinedFilesPanel"
             x:DataType="vm:LoadOrderViewModel">
  <!-- Files more than one mod changes, and what happened to each (ADR-0026 §1). -->
  <controls:Card Margin="12,0,12,12">
    <StackPanel Spacing="10">
      <TextBlock Classes="SectionTitle" Text="Combined files" />
      <TextBlock Classes="Secondary" TextWrapping="Wrap"
                 Text="Files more than one of your mods changes. Some are merged so every mod's part works; for the rest, one copy is used." />
      <ItemsControl Name="CombinedFiles" ItemsSource="{Binding CombinedFiles}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:FileConflictRow">
            <Border Padding="0,10" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,1,0,0">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="2">
                  <TextBlock Classes="Mono" FontWeight="SemiBold" Text="{Binding FileName}" />
                  <TextBlock TextWrapping="Wrap" Text="{Binding Detail}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Classes="Status" Text="Combined" VerticalAlignment="Top" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <ItemsControl Name="PackedFiles" ItemsSource="{Binding PackedConflicts}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:FileConflictRow">
            <Border Padding="0,10" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,1,0,0">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="2">
                  <TextBlock Classes="Mono" FontWeight="SemiBold" Text="{Binding FileName}" />
                  <TextBlock Classes="Secondary" TextWrapping="Wrap" Text="{Binding Detail}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Classes="Warning" Text="{Binding Winner}" VerticalAlignment="Top" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <ItemsControl Name="SharedFiles" ItemsSource="{Binding Conflicts}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:FileConflictRow">
            <Border Padding="0,10" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,1,0,0">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="2">
                  <TextBlock Classes="Mono" FontWeight="SemiBold" Text="{Binding FileName}" />
                  <TextBlock Text="{Binding Winner}" />
                  <TextBlock Classes="Secondary" TextWrapping="Wrap" Text="{Binding Detail}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Classes="Warning" Text="One wins" VerticalAlignment="Top" IsVisible="{Binding !SameContent}" />
                <TextBlock Grid.Column="1" Classes="Secondary" Text="Same in each" VerticalAlignment="Top" IsVisible="{Binding SameContent}" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Name="NoSharedFiles" Classes="Secondary" Text="No two mods change the same file right now.">
        <TextBlock.IsVisible>
          <MultiBinding Converter="{x:Static BoolConverters.And}">
            <Binding Path="!Conflicts.Count" />
            <Binding Path="!PackedConflicts.Count" />
          </MultiBinding>
        </TextBlock.IsVisible>
      </TextBlock>
      <TextBlock Classes="Secondary" TextWrapping="Wrap" FontSize="12"
                 Text="Combined: merged into one file. One wins: can't be merged, like a texture; Arrange chooses which. Some files, like data tables and scripts, need a compatibility patch from the mods' authors." />
    </StackPanel>
  </controls:Card>
</UserControl>
