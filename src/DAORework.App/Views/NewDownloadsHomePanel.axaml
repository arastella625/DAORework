<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DAORework.App.ViewModels"
             xmlns:views="using:DAORework.App.Views"
             xmlns:controls="using:DAORework.App.Controls"
             x:Class="DAORework.App.Views.NewDownloadsHomePanel"
             x:DataType="vm:NewDownloadsViewModel">
  <!-- Home's part of ADR-0034: the question, asked once, and how many mods are waiting. -->
  <StackPanel Spacing="12">
    <controls:Card Name="NewDownloadsQuestion" Margin="12,0" IsVisible="{Binding Settings.ShowsQuestion}">
      <StackPanel Spacing="8">
        <TextBlock FontWeight="SemiBold" Text="Add mods straight from your downloads?" />
        <TextBlock Classes="Secondary" TextWrapping="Wrap" Text="DAORework would notice mods you download from now on and offer them on the Mods tab. It only reads that folder, and adds nothing until you say so." />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Name="DownloadsYes" Classes="accent" Content="Turn on" Command="{Binding Settings.TurnOnCommand}" />
          <Button Name="DownloadsNo" Content="No thanks" Command="{Binding Settings.TurnOffCommand}" />
        </StackPanel>
      </StackPanel>
    </controls:Card>
    <controls:Card Name="NewDownloadsWaiting" Margin="12,0" IsVisible="{Binding HomeLine, Converter={x:Static ObjectConverters.IsNotNull}}">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding HomeLine}" />
        <Button Grid.Column="1" Content="See them" Command="{Binding $parent[views:HomePage].((vm:HomeViewModel)DataContext).SeeNewDownloadsCommand}" />
      </Grid>
    </controls:Card>
  </StackPanel>
</UserControl>
