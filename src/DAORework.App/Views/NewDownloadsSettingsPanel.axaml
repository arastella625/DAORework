<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DAORework.App.ViewModels"
             xmlns:controls="using:DAORework.App.Controls"
             x:Class="DAORework.App.Views.NewDownloadsSettingsPanel"
             x:DataType="vm:NewDownloadsSettingsViewModel">
  <controls:Card Margin="12,0">
    <StackPanel Spacing="8">
      <TextBlock Classes="SectionTitle" Text="New downloads" />
      <TextBlock Classes="Secondary" TextWrapping="Wrap"
                 Text="Offers mods you download on the Mods tab. It looks for the game's own files, so a retexture of only .dds files isn't noticed: Add mods takes any mod." />
      <TextBlock Name="DownloadsFolder" TextWrapping="Wrap" Text="{Binding FolderText}" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Name="DownloadsOn" Content="Turn on" Command="{Binding TurnOnCommand}" IsVisible="{Binding !Enabled}" />
        <Button Name="DownloadsOff" Content="Turn off" Command="{Binding TurnOffCommand}" IsVisible="{Binding Enabled}" />
        <Button Name="DownloadsFolderButton" Content="Choose folder" Command="{Binding ChooseFolderCommand}" />
      </StackPanel>
    </StackPanel>
  </controls:Card>
</UserControl>
