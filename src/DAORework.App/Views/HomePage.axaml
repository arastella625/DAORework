<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DAORework.App.ViewModels"
             xmlns:views="using:DAORework.App.Views"
             xmlns:controls="using:DAORework.App.Controls"
             xmlns:mods="using:DAORework.Core.Mods"
             x:Class="DAORework.App.Views.HomePage"
             x:DataType="vm:HomeViewModel">
  <!-- Home (ADR-0026, P2.5-25, ADR-0050 §1): one card that says whether to play or what to do first, the last change, and what is worth a look. -->
  <ScrollViewer>
    <StackPanel Margin="12" Spacing="12">
      <!-- One card: a headline, one sentence and one button (ADR-0050 §1, P2.10-02); the last change beside it. -->
      <Grid ColumnDefinitions="3*,12,2*">
        <controls:Card Name="Headline">
          <Panel ClipToBounds="True">
          <!-- A soft burst of gold behind the good news; a plain theme draws none (ADR-0026 §4). -->
          <Canvas Opacity="{DynamicResource OrnamentOpacity}" IsVisible="{Binding IsReady}" IsHitTestVisible="False">
            <controls:Sunburst Width="260" Height="260" Canvas.Right="-90" Canvas.Top="-110"
                               Opacity="0.4" Brush="{DynamicResource HeadingBrush}" />
          </Canvas>
          <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <PathIcon Classes="Ok" Width="22" Height="22" Data="{StaticResource IconOk}" IsVisible="{Binding IsReady}" />
              <PathIcon Classes="Warning" Width="22" Height="22" Data="{StaticResource IconWarning}" IsVisible="{Binding HasProblems}" />
              <TextBlock Name="HeadlineTitle" Classes="PageTitle" Text="{Binding Card.Title}" />
            </StackPanel>
            <TextBlock Name="HeadlineSentence" Classes="Secondary" TextWrapping="Wrap" Text="{Binding Card.Sentence}" />
            <!-- Where a new player is (P2.6-36). It goes once a mod is on, so there is nothing to dismiss. -->
            <ItemsControl Name="FirstSteps" ItemsSource="{Binding NextMove.FirstSteps, FallbackValue={x:Null}}"
                          IsVisible="{Binding NextMove.FirstSteps.Count, Converter={x:Static views:CountConverters.IsPositive}, FallbackValue=False}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="16" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="mods:FirstStep">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <PathIcon Classes="Ok" Width="12" Height="12" Data="{StaticResource IconOk}" IsVisible="{Binding IsDone}" />
                    <TextBlock Classes="Secondary" Text="{Binding Name}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Name="HeadlineButton" Classes="accent" HorizontalAlignment="Left" Content="{Binding Card.Button}"
                    Command="{Binding TakeCardCommand}" IsVisible="{Binding HasButton}" />
          </StackPanel>
          </Panel>
        </controls:Card>
        <controls:Card Grid.Column="2">
          <StackPanel Spacing="6">
            <TextBlock Classes="Label" Text="Last change" />
            <StackPanel Spacing="6" IsVisible="{Binding HasLastChange}">
              <TextBlock Name="LastChange" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding LastChange}" />
              <TextBlock Classes="Secondary" Text="{Binding LastChangeAt, Converter={x:Static views:FriendlyTimeConverter.Instance}}" />
              <Button Name="UndoLastButton" Content="Undo" Command="{Binding UndoLastCommand}" HorizontalAlignment="Left" />
            </StackPanel>
            <TextBlock Classes="Secondary" Text="Nothing changed yet." IsVisible="{Binding !HasLastChange}" />
          </StackPanel>
        </controls:Card>
      </Grid>

      <controls:Card IsVisible="{Binding Setup.HasModsOn, FallbackValue=False}">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <TextBlock Classes="Secondary" VerticalAlignment="Center" TextWrapping="Wrap" Text="Something going wrong in your game? This finds which mod is the cause." />
          <Button Name="FindProblemButton" Grid.Column="1" Content="Find the problem mod"
                  Command="{Binding OpenCommand}" CommandParameter="{x:Static vm:HomeTarget.ModsCombined}" />
        </Grid>
      </controls:Card>

      <views:NewDownloadsHomePanel DataContext="{Binding NewDownloads}" />
      <views:NextStepsPanel DataContext="{Binding NextSteps}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
