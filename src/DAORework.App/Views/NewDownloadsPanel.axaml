<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DAORework.App.ViewModels"
             xmlns:views="using:DAORework.App.Views"
             xmlns:controls="using:DAORework.App.Controls"
             x:Class="DAORework.App.Views.NewDownloadsPanel"
             x:DataType="vm:NewDownloadsViewModel">
  <!-- New downloads (ADR-0034 §5): shown when there is something to add, or the folder can't be read. -->
  <controls:Card Margin="12,0">
    <StackPanel Spacing="10">
      <TextBlock Classes="SectionTitle" Text="New downloads" />
      <TextBlock Name="NewDownloadsStatus" Classes="Status" Classes.Error="{Binding IsError}" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
      <ItemsControl Name="NewDownloadRows" ItemsSource="{Binding Rows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:NewDownloadRow">
            <Border Padding="0,8" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,1,0,0">
              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <StackPanel Spacing="2">
                  <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                  <TextBlock Classes="Mono Secondary" Text="{Binding Details}" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" VerticalAlignment="Top" Content="Add" CommandParameter="{Binding}"
                        Command="{Binding $parent[views:NewDownloadsPanel].((vm:NewDownloadsViewModel)DataContext).AddOneCommand}" />
                <Button Grid.Column="2" VerticalAlignment="Top" Content="Not this one" CommandParameter="{Binding}"
                        Command="{Binding $parent[views:NewDownloadsPanel].((vm:NewDownloadsViewModel)DataContext).NotThisOneCommand}" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Name="AddAllButton" Classes="accent" Content="Add all" Command="{Binding AddAllCommand}" IsVisible="{Binding !IsError}" />
        <Button Name="LookAgainButton" Content="Look again" Command="{Binding LookAgainCommand}" />
        <Button Name="ChooseDownloadsButton" Content="Choose folder" Command="{Binding Settings.ChooseFolderCommand}" IsVisible="{Binding IsError}" />
      </StackPanel>
    </StackPanel>
  </controls:Card>
</UserControl>
