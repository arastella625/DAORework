<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DAORework.App.ViewModels"
             xmlns:views="using:DAORework.App.Views"
             xmlns:controls="using:DAORework.App.Controls"
             x:Class="DAORework.App.Views.LibraryPanel"
             x:DataType="vm:ModsTabViewModel"
             DragDrop.AllowDrop="True">
  <controls:Card Margin="12,0,12,12">
    <StackPanel Spacing="10">
      <TextBlock Classes="SectionTitle" Text="Your mods" />
      <Grid ColumnDefinitions="Auto,12,Auto,12,*">
        <Button Name="ImportFileButton" Content="Add mods" Command="{Binding Library.ImportFileCommand}" />
        <Button Grid.Column="2" Name="ImportFolderButton" Content="Add a folder" Command="{Binding Library.ImportFolderCommand}" />
        <TextBlock Grid.Column="4" VerticalAlignment="Center" Classes="Secondary" TextWrapping="Wrap"
                   Text="Or drop .dazip, .zip, .7z or .rar files here. Adding a mod doesn't change your game until you turn it on." />
      </Grid>
      <TextBlock Name="LibraryStatus" Classes="Status" Classes.Error="{Binding Library.IsError}" Text="{Binding Library.StatusMessage}" TextWrapping="Wrap"
                 IsVisible="{Binding Library.StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <Border Name="PlanPreview" Padding="12" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource BorderSoftBrush}"
              IsVisible="{Binding Activation.Preview.Title, Converter={x:Static ObjectConverters.IsNotNull}}">
        <StackPanel Spacing="8">
          <views:PlanPreviewView DataContext="{Binding Activation.Preview}" />
          <TextBlock Classes="Secondary" TextWrapping="Wrap" IsVisible="{Binding Activation.CanApply}"
                     Text="Nothing changes in your game until you apply it." />
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Button Name="ApplyPlanButton" Classes="accent" Content="Apply" Command="{Binding Activation.ApplyCommand}"
                    IsVisible="{Binding !Activation.CanLeaveOut}" />
            <Button Name="LeaveOutButton" Classes="accent" Content="{Binding Activation.LeaveOutLabel}" Command="{Binding Activation.LeaveOutCommand}"
                    IsVisible="{Binding Activation.CanLeaveOut}" />
            <Button Name="CancelPlanButton" Content="Cancel" Command="{Binding Activation.CancelPlanCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
      <TextBlock Name="ActivationStatus" Classes="Status" Classes.Error="{Binding Activation.IsError}" Text="{Binding Activation.StatusMessage}" TextWrapping="Wrap"
                 IsVisible="{Binding Activation.StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <TextBlock Name="LibraryEmpty" Classes="Secondary" TextWrapping="Wrap"
                 Text="No mods yet. A mod you add is kept here and scanned by your antivirus; it reaches your game only when you turn it on."
                 IsVisible="{Binding !Library.Mods.Count}" />
      <StackPanel Name="LibrarySelectionBar" Orientation="Horizontal" Spacing="8"
                  IsVisible="{Binding Library.Mods.Count, Converter={x:Static views:CountConverters.IsPositive}}">
        <Button Name="ActivateSelectedButton" Classes="accent" Content="Turn on selected" Command="{Binding Selection.ActivateSelectedCommand}" />
        <Button Name="DeactivateSelectedButton" Content="Turn off selected" Command="{Binding Selection.DeactivateSelectedCommand}" />
        <Button Name="SelectAllModsButton" Content="Select all" Command="{Binding Selection.SelectAllCommand}" />
        <Button Name="ClearModsSelectionButton" Content="Clear" Command="{Binding Selection.ClearSelectionCommand}" />
      </StackPanel>
      <ItemsControl Name="LibraryMods" ItemsSource="{Binding Filter.VisibleMods}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:LibraryModRow">
            <Border Padding="0,10" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,1,0,0">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <CheckBox VerticalAlignment="Top" IsChecked="{Binding IsSelected}" ToolTip.Tip="Tick to activate or deactivate it with the others" />
                <StackPanel Grid.Column="1" Spacing="3">
                  <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                  <TextBlock Classes="Mono Secondary" Text="{Binding Details}" TextWrapping="Wrap" />
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" IsVisible="{Binding Warning, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <PathIcon Classes="Warning" Data="{StaticResource IconWarning}" VerticalAlignment="Top" />
                    <TextBlock Grid.Column="1" Classes="Warning" Text="{Binding Warning}" TextWrapping="Wrap" />
                  </Grid>
                  <TextBlock Classes="Secondary" TextWrapping="Wrap" IsVisible="{Binding IsInGame}"
                             Text="Already in your game. Turning it on takes that copy over, so there's no second one." />
                  <ItemsControl ItemsSource="{Binding Notes}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Button Content="Open the mod's page" HorizontalAlignment="Left" CommandParameter="{Binding PageLink}"
                          IsVisible="{Binding PageLink, Converter={x:Static ObjectConverters.IsNotNull}}"
                          Command="{Binding $parent[views:LibraryPanel].((vm:ModsTabViewModel)DataContext).ModPage.OpenCommand}" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Top">
                  <!-- A switch (ADR-0026 §4): clicking it shows the preview; it moves once the change is applied. -->
                  <Button Classes="switch" Content="Off" IsVisible="{Binding !IsActive}" CommandParameter="{Binding}"
                          AutomationProperties.Name="{Binding Title, StringFormat='Turn on {0}'}" ToolTip.Tip="Turn on"
                          Command="{Binding $parent[views:LibraryPanel].((vm:ModsTabViewModel)DataContext).Activation.ActivateCommand}" />
                  <Button Classes="switch on" Content="On" IsVisible="{Binding IsActive}" CommandParameter="{Binding}"
                          AutomationProperties.Name="{Binding Title, StringFormat='Turn off {0}'}" ToolTip.Tip="Turn off"
                          Command="{Binding $parent[views:LibraryPanel].((vm:ModsTabViewModel)DataContext).Activation.DeactivateCommand}" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </controls:Card>
</UserControl>
