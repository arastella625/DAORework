<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DAORework.App.ViewModels"
             xmlns:controls="using:DAORework.App.Controls"
             x:Class="DAORework.App.Views.ProblemSearchPanel"
             x:DataType="vm:ProblemSearchViewModel">
  <!-- Finding the problem mod (ADR-0042). Each round's preview opens in the sheet with the others. -->
  <controls:Card Margin="12,0,12,12">
    <StackPanel Spacing="10">
      <TextBlock Name="SearchHeadline" Classes="SectionTitle" Text="{Binding Headline}" />
      <TextBlock Classes="Secondary" TextWrapping="Wrap" Text="{Binding Body}" />
      <TextBlock Name="SearchStatus" Classes="Status" Classes.Error="{Binding IsError}" Text="{Binding StatusMessage}" TextWrapping="Wrap"
                 IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <StackPanel Spacing="10" IsVisible="{Binding IsIdle}">
        <TextBox Name="ProblemWords" Text="{Binding Problem}" PlaceholderText="What's going wrong? Such as: the game crashes in Denerim" />
        <CheckBox Name="KeepLooksOn" Content="Keep my looks on, and test gameplay mods only" IsChecked="{Binding KeepLooksOn}" />
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Button Name="StartSearchButton" Content="Start" Command="{Binding StartCommand}" />
          <Button Name="StartPlainButton" Content="Check with no mods first" Command="{Binding StartPlainCommand}"
                  ToolTip.Tip="Turns every mod off, to learn whether it's a mod at all." />
        </StackPanel>
      </StackPanel>
      <StackPanel Spacing="10" IsVisible="{Binding IsTesting}">
        <TextBlock Name="YouSaid" TextWrapping="Wrap" Text="{Binding YouSaid}" IsVisible="{Binding YouSaid, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <TextBlock Name="DontSave" Classes="Warning" TextWrapping="Wrap" Text="{x:Static vm:ProblemSearchViewModel.DontSave}" />
        <ProgressBar Name="RuledOutBar" Minimum="0" Maximum="100" Value="{Binding RuledOut}" />
        <TextBlock Classes="Secondary" Text="{Binding Progress}" />
        <TextBlock Name="OutOfStep" Classes="Warning" TextWrapping="Wrap" Text="{x:Static vm:ProblemSearchViewModel.OutOfStepNote}" IsVisible="{Binding IsOutOfStep}" />
        <Button Name="PutRoundBackButton" Classes="accent" Content="Put this round's mods back" Command="{Binding PutRoundBackCommand}" IsVisible="{Binding IsOutOfStep}" />
        <Button Name="StillHappensButton" HorizontalAlignment="Stretch" Content="{Binding StillHappensLabel}" Command="{Binding StillHappensCommand}" IsVisible="{Binding CanAnswer}" />
        <Button Name="ItsGoneButton" HorizontalAlignment="Stretch" Content="{Binding ItsGoneLabel}" Command="{Binding ItsGoneCommand}" IsVisible="{Binding CanAnswer}" />
        <Button Name="StopSearchButton" Content="Stop and turn everything back on" Command="{Binding PutBackCommand}" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding IsFinished}">
        <Button Name="PutBackWithoutButton" Classes="accent" Content="{Binding PutBackWithoutLabel}" Command="{Binding PutBackWithoutCommand}" IsVisible="{Binding Found}" />
        <Button Name="PutBackButton" Content="Put everything back" Command="{Binding PutBackCommand}" />
      </StackPanel>
      <Button Name="ForgetSearchButton" HorizontalAlignment="Left" Content="Forget this search" Command="{Binding ForgetCommand}" IsVisible="{Binding !IsIdle}"
              ToolTip.Tip="Stops the search and leaves your mods as they are now." />
    </StackPanel>
  </controls:Card>
</UserControl>
