<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DAORework.App.ViewModels"
             xmlns:views="using:DAORework.App.Views"
             xmlns:controls="using:DAORework.App.Controls"
             x:Class="DAORework.App.Views.ModsListPanel"
             x:DataType="vm:ModsTabViewModel">
  <!-- The Mods tab as one page (ADR-0026, P2.5-26): the kind cards and chips filter it; Arrange turns it into the load order. -->
  <StackPanel Spacing="12">
    <ItemsControl Name="KindCards" Margin="12,0" ItemsSource="{Binding Setup.Parts}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid Columns="3" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:SetupPart">
          <Button Margin="0,0,10,0" Padding="14,12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                  Command="{Binding $parent[views:ModsListPanel].((vm:ModsTabViewModel)DataContext).Filter.PickKindCommand}" CommandParameter="{Binding Kind}">
            <Grid ColumnDefinitions="Auto,12,*">
              <controls:Seal VerticalAlignment="Top" Classes.warning="{Binding NeedsALook}">
                <Panel>
                  <PathIcon Classes="Ok" Width="13" Height="13" Data="{StaticResource IconOk}" IsVisible="{Binding IsReady}" />
                  <PathIcon Classes="Warning" Width="13" Height="13" Data="{StaticResource IconWarning}" IsVisible="{Binding NeedsALook}" />
                </Panel>
              </controls:Seal>
              <StackPanel Grid.Column="2" Spacing="2">
                <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                <TextBlock Classes="Secondary" TextWrapping="Wrap" Text="{Binding Count}" />
                <TextBlock Classes="Status" Text="{Binding Status}" IsVisible="{Binding IsReady}" />
                <TextBlock Classes="Warning" Text="{Binding Status}" IsVisible="{Binding NeedsALook}" />
              </StackPanel>
            </Grid>
          </Button>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- Not while arranging: it has no job there, and the list needs the room. -->
    <Panel IsVisible="{Binding !Filter.Arranging}">
      <views:NextMovePanel DataContext="{Binding NextMove}" IsVisible="{Binding IsShown}" x:DataType="vm:NextMoveCard" />
    </Panel>
    <views:VortexHandoverPanel DataContext="{Binding Handover}" IsVisible="{Binding IsShown}" x:DataType="vm:VortexHandoverViewModel" />
    <views:NewDownloadsPanel DataContext="{Binding NewDownloads}" IsVisible="{Binding IsShown}" x:DataType="vm:NewDownloadsViewModel" />

    <WrapPanel Margin="12,0" DataContext="{Binding Filter}" x:DataType="vm:ModListFilter">
      <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,0,24,0" IsVisible="{Binding !Arranging}">
        <RadioButton Name="ShowAll" GroupName="show" Content="{Binding AllLabel}" IsChecked="{Binding IsAll, Mode=OneWay}"
                     Command="{Binding ShowOnlyCommand}" CommandParameter="{x:Static vm:ModShowFilter.All}" />
        <RadioButton Name="ShowOn" GroupName="show" Content="{Binding OnLabel}" IsChecked="{Binding IsOn, Mode=OneWay}"
                     Command="{Binding ShowOnlyCommand}" CommandParameter="{x:Static vm:ModShowFilter.On}" />
        <RadioButton Name="ShowOff" GroupName="show" Content="{Binding OffLabel}" IsChecked="{Binding IsOff, Mode=OneWay}"
                     Command="{Binding ShowOnlyCommand}" CommandParameter="{x:Static vm:ModShowFilter.Off}" />
        <RadioButton Name="ShowFound" GroupName="show" Content="{Binding FoundLabel}" IsChecked="{Binding IsFound, Mode=OneWay}"
                     Command="{Binding ShowOnlyCommand}" CommandParameter="{x:Static vm:ModShowFilter.Found}" />
        <RadioButton Name="ShowGameFolder" GroupName="show" Content="{Binding GameFolderLabel}" IsChecked="{Binding IsGameFolder, Mode=OneWay}"
                     IsVisible="{Binding HasGameFolder}"
                     Command="{Binding ShowOnlyCommand}" CommandParameter="{x:Static vm:ModShowFilter.GameFolder}" />
      </StackPanel>
      <Button Name="ArrangeButton" Content="{Binding ArrangeLabel}" Command="{Binding ToggleArrangeCommand}" />
    </WrapPanel>

    <Grid Margin="12,0" ColumnDefinitions="*,Auto" ColumnSpacing="10" DataContext="{Binding Filter}" x:DataType="vm:ModListFilter"
          IsVisible="{Binding ShowsList}">
      <TextBox Name="ModSearch" Text="{Binding SearchText}" PlaceholderText="Search your mods" />
      <ComboBox Name="ModSortBox" Grid.Column="1" MinWidth="130" SelectedIndex="{Binding SortIndex}">
        <ComboBoxItem Content="By name" />
        <ComboBoxItem Content="Newest first" />
        <ComboBoxItem Content="On first" />
      </ComboBox>
    </Grid>
    <TextBlock Name="NothingMatches" Margin="12,0" Classes="Secondary" Text="No mods match that." DataContext="{Binding Filter}"
               x:DataType="vm:ModListFilter" IsVisible="{Binding NothingMatches}" />
    <StackPanel Margin="12,0" Orientation="Horizontal" Spacing="8" DataContext="{Binding Filter}" x:DataType="vm:ModListFilter"
                IsVisible="{Binding HasKind}">
      <TextBlock Name="KindNote" Classes="Secondary" VerticalAlignment="Center" Text="{Binding KindNote}" />
      <Button Name="ShowEveryKindButton" Content="Show every kind" Command="{Binding ShowEveryKindCommand}" />
    </StackPanel>

    <TextBlock Name="ModPageStatus" Margin="12,0" Classes="Status" Classes.Error="{Binding ModPage.IsError}" Text="{Binding ModPage.StatusMessage}" TextWrapping="Wrap"
               IsVisible="{Binding ModPage.StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    <views:LibraryPanel IsVisible="{Binding Filter.ShowsMods}" />
    <views:HandInstalledPanel DataContext="{Binding HandInstalled}" IsVisible="{Binding $parent[views:ModsListPanel].((vm:ModsTabViewModel)DataContext).Filter.ShowsFound}" />
    <views:LoadOrderPanel DataContext="{Binding LoadOrder}" IsVisible="{Binding $parent[views:ModsListPanel].((vm:ModsTabViewModel)DataContext).Filter.Arranging}" />
    <views:CombinedFilesPanel DataContext="{Binding LoadOrder}" IsVisible="{Binding $parent[views:ModsListPanel].((vm:ModsTabViewModel)DataContext).Filter.ShowsCombined}" />
    <views:ProblemSearchPanel DataContext="{Binding ProblemSearch}">
      <views:ProblemSearchPanel.IsVisible>
        <MultiBinding Converter="{x:Static BoolConverters.Or}">
          <Binding Path="$parent[views:ModsListPanel].((vm:ModsTabViewModel)DataContext).Filter.ShowsCombined" />
          <Binding Path="!IsIdle" />
        </MultiBinding>
      </views:ProblemSearchPanel.IsVisible>
    </views:ProblemSearchPanel>
  </StackPanel>
</UserControl>
