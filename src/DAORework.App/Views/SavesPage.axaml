<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DAORework.App.ViewModels"
             xmlns:views="using:DAORework.App.Views"
             xmlns:controls="using:DAORework.App.Controls"
             xmlns:saves="using:DAORework.Core.Saves"
             x:Class="DAORework.App.Views.SavesPage"
             x:DataType="vm:SavesPageViewModel">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Top" Spacing="8">
      <StackPanel Spacing="6">
        <TextBlock Classes="PageTitle" Text="Saves" />
        <controls:RuneDivider />
      </StackPanel>
      <TextBlock TextWrapping="Wrap" Classes="Secondary"
                 Text="Backups copy your saves into DAORework's own folder. Your saves folder is only ever read, never changed." />
      <StackPanel Orientation="Horizontal" Spacing="12">
        <Button Name="BackUpButton" Content="Back up now" Classes="accent" Command="{Binding BackUpCommand}" />
        <TextBlock VerticalAlignment="Center" Text="Keep the newest" />
        <NumericUpDown Name="KeepLatest" Value="{Binding KeepLatest}" Minimum="1" Maximum="1000" Increment="1" FormatString="0" Width="130" />
        <TextBlock VerticalAlignment="Center" Text="backups" />
        <Button Name="RefreshButton" Content="Refresh" Command="{Binding RefreshCommand}" />
        <TextBlock VerticalAlignment="Center" Classes="Secondary" Text="{Binding ProfileName, TargetNullValue='No profile selected'}" />
      </StackPanel>
      <TextBlock Name="Status" Classes="Status" Classes.Error="{Binding IsError}" Text="{Binding StatusMessage}" />
    </StackPanel>
    <ScrollViewer Margin="0,12,0,0">
      <ItemsControl Name="Backups" ItemsSource="{Binding Backups}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="saves:SaveBackup">
            <Grid ColumnDefinitions="210,110,*" Margin="0,2">
              <TextBlock Grid.Column="0" Text="{Binding CreatedAtUtc, Converter={x:Static views:FriendlyTimeConverter.Instance}}" />
              <TextBlock Grid.Column="1" Text="{Binding SizeBytes, Converter={x:Static views:ByteSizeConverter.Instance}}" />
              <SelectableTextBlock Grid.Column="2" Text="{Binding Path}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>
